# Kopiere diese Datei zu ".env" (nur für den Start auf dem eigenen PC).
# Beim Hoster (Render, Oracle …) trägst du die Werte stattdessen als "Environment Variables" ein.

# Pflicht: Bot-Token aus dem Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=

# Empfohlen (Pflicht bei Render): kostenlose MongoDB-Atlas-Datenbank, damit Einstellungen Neustarts überleben
MONGODB_URI=

# Optional: Google-Safe-Browsing-Schlüssel – prüft zusätzlich unbekannte Links
SAFE_BROWSING_KEY=

# Optional: Farbe der Embeds (Hex ohne #)
BRAND_COLOR=ff2d55

# Optional: Befehle nur auf einem Test-Server registrieren (Server-ID)
DEV_GUILD_ID=

# Optional: Zeitzone für Zeitangaben
TZ=Europe/Berlin
